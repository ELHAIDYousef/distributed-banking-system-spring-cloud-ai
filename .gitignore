# =====================================================================
#  Root .gitignore — Microservices project (Spring Boot / Spring Cloud /
#  Spring AI / MCP / Angular / Docker / Keycloak)
#  Patterns without a leading "/" match in EVERY module folder.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Secrets & environment  (NEVER commit real credentials)
# ---------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!**/.env.example

# Local Spring profiles that may hold secrets (API keys, bot tokens...)
application-local.yml
application-local.yaml
application-local.properties
application-secrets.*

# Keys / certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.truststore
!**/src/test/resources/**/*.jks

# ---------------------------------------------------------------------
# 2. Java / Maven build output
# ---------------------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.flattened-pom.xml

# Compiled / packaged files
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*

# Spring Initializr leftovers
HELP.md

# ---------------------------------------------------------------------
# 3. Gradle (in case a module ever uses it)
# ---------------------------------------------------------------------
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ---------------------------------------------------------------------
# 4. IDEs
# ---------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# Eclipse / Spring Tools Suite
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.history/

# ---------------------------------------------------------------------
# 5. Logs, temp & runtime files
# ---------------------------------------------------------------------
logs/
*.log
*.log.*
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.orig
*.pid

# ---------------------------------------------------------------------
# 6. Docker / local data volumes
#    (we commit Dockerfile & docker-compose.yml, NOT the data)
# ---------------------------------------------------------------------
docker-data/
data/
volumes/
pgdata/
postgres-data/
keycloak-data/
docker-compose.override.yml

# ---------------------------------------------------------------------
# 7. Kubernetes (final step) — never commit real secrets
# ---------------------------------------------------------------------
k8s/**/secret*.yaml
k8s/**/secret*.yml
!k8s/**/secret*.example.yaml
kubeconfig
*.kubeconfig

# ---------------------------------------------------------------------
# 8. Frontend — Angular / Node (Part 3)
# ---------------------------------------------------------------------
node_modules/
.angular/
dist/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.sass-cache/
coverage/
*.tsbuildinfo

# ---------------------------------------------------------------------
# 9. Spring AI / local AI artifacts
# ---------------------------------------------------------------------
# Local vector stores & downloaded models (big, machine-specific)
vector-store/
*.vectorstore.json
models/
*.gguf
*.onnx

# ---------------------------------------------------------------------
# 10. Operating systems
# ---------------------------------------------------------------------
# Linux
.directory
.Trash-*
.nfs*
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/